rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global leaderboard: anyone can read; signed-in (anonymous) players can
    // only append their own scores. No edits, no deletes.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'levelId', 'characterId', 'score', 'likes', 'kills', 'seconds', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.levelId in ['feed', 'comments', 'server']
        && request.resource.data.characterId in ['wig_dog', 'stare_cat', 'robber_dog', 'smile_dog']
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score < 10000000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
